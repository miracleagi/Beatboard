{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "rm -rf .beatboard-runs && rm -rf web/src && cp -r src web/src",
    "devPath": "../web",
    "distDir": "../web",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Beatboard",
    "version": "0.9.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "protocol": {
        "asset": true,
        "assetScope": ["$APPDATA/**", "$HOME/**"]
      },
      "dialog": {
        "open": true,
        "save": false,
        "message": true
      },
      "window": {
        "startDragging": true,
        "maximize": true,
        "unmaximize": true,
        "minimize": true,
        "close": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["dmg", "app"],
      "identifier": "com.beatboard.app",
      "icon": [
        "icons/icon.png",
        "icons/icon.icns"
      ],
      "resources": [
        "runtime/pixverse-package/package.json",
        "runtime/pixverse-package/package-lock.json",
        "THIRD_PARTY_NOTICES.md"
      ],
      "externalBin": ["binaries/ffmpeg"],
      "copyright": "",
      "category": "Productivity",
      "shortDescription": "Beat-level AI media canvas",
      "macOS": {
        "frameworks": [],
        "exceptionDomain": "",
        "signingIdentity": "Developer ID Application: Zheng Chuanchuan (35NCMHD8DT)",
        "minimumSystemVersion": "12.0",
        "entitlements": null
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Beatboard",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
